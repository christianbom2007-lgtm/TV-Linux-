{
  "manifest_version": 2,
  "name": "Lichtung TV",
  "version": "1.1.0",
  "description": "Verbindet Firefox mit Lichtung TV: Home-Taste, Lautstärkeanzeige, Weiterschauen, TV-Ansicht.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tv@lichtung.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}