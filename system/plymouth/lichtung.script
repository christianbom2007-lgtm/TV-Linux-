# Lichtung TV – Bootbildschirm
# Dunkler Hintergrund, Schriftzug blendet sanft ein, darunter ein wandernder
# Lichtpunkt auf einer feinen Linie (wie beim Öffnen einer Kachel).

Window.SetBackgroundTopColor(0.020, 0.027, 0.024);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.024);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo_raw = Image("logo.png");
scale = (sh * 0.10) / logo_raw.GetHeight();
logo_img = logo_raw.Scale(logo_raw.GetWidth() * scale, logo_raw.GetHeight() * scale);
logo = Sprite(logo_img);
logo.SetX(sw / 2 - logo_img.GetWidth() / 2);
logo.SetY(sh / 2 - logo_img.GetHeight() / 2);
logo.SetOpacity(0);

track_img = Image("track.png").Scale(sw * 0.10, 2);
glow_img = Image("glow.png").Scale(sw * 0.035, 2);
track = Sprite(track_img);
track.SetX(sw / 2 - track_img.GetWidth() / 2);
track.SetY(sh / 2 + logo_img.GetHeight() / 2 + sh * 0.03);
track.SetOpacity(0);
glow = Sprite(glow_img);
glow.SetY(track.GetY());
glow.SetOpacity(0);

t = 0;
fun refresh_callback() {
  t = t + 1;
  op = t / 45;
  if (op > 1) op = 1;
  logo.SetOpacity(op);
  track.SetOpacity(op * 0.8);
  glow.SetOpacity(op);
  pos = t / 80 - Math.Int(t / 80);
  glow.SetX(track.GetX() + (track_img.GetWidth() - glow_img.GetWidth()) * pos);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Passwortabfrage (nur falls die Festplatte verschlüsselt ist)
bullet_img = Image("glow.png").Scale(sh * 0.012, sh * 0.012);
fun display_password_callback(prompt, bullets) {
  for (i = 0; i < 32; i++) if (bullet[i]) bullet[i].SetOpacity(0);
  for (i = 0; i < bullets; i++) {
    bullet[i] = Sprite(bullet_img);
    bullet[i].SetX(sw / 2 - bullets * sh * 0.01 + i * sh * 0.02);
    bullet[i].SetY(sh * 0.7);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun display_normal_callback() {
  for (i = 0; i < 32; i++) if (bullet[i]) bullet[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
